local function updateKickStatus()
    if kickLoopEnabled then
        Options.KickStatusLabel:SetText("🟢 実行中")
        if selectedKickPlayer then
            Options.KickTargetStatus:SetText(selectedKickPlayer.DisplayName .. " (" .. selectedKickPlayer.Name .. ")")
        end
    else
        Options.KickStatusLabel:SetText("🔴 停止中")
        if selectedKickPlayer then
            Options.KickTargetStatus:SetText(selectedKickPlayer.DisplayName .. " (" .. selectedKickPlayer.Name .. ")")
        else
            Options.KickTargetStatus:SetText("未選択")
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if Library.Unloaded then break end
        pcall(updateKickStatus)
    end
end)

