-- =====================================================
-- Kill All 機能 (Killタブ用)
-- =====================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = Workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local isRunning = false
local killTask = nil
local currentBlobman = nil
local maxRetries = 5
local TP_WAIT = 0.02
local GRAB_WAIT = 0.005

-- 視点切り替え処理 (Kill用)
local function EnableThirdPersonKill()
	pcall(function()
		LocalPlayer.CameraMode = Enum.CameraMode.Classic
		Camera.CameraType = Enum.CameraType.Custom
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			Camera.CameraSubject = LocalPlayer.Character.Humanoid
		end
		LocalPlayer.CameraMaxZoomDistance = 100
		LocalPlayer.CameraMinZoomDistance = 0.5
	end)
end

local function DisableThirdPersonKill()
	pcall(function()
		LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
		Camera.CameraType = Enum.CameraType.Custom
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			Camera.CameraSubject = LocalPlayer.Character.Humanoid
		end
		LocalPlayer.CameraMaxZoomDistance = 0
		LocalPlayer.CameraMinZoomDistance = 0
	end)
end

-- ブロブマン関連処理 (Kill用)
local function MountBlobman(blobman)
	if not blobman then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end

	if humanoid.SeatPart and humanoid.SeatPart.Parent == blobman then
		return true
	end

	local seat = blobman:FindFirstChild("VehicleSeat")
	if not seat then
		for _, child in ipairs(blobman:GetDescendants()) do
			if child:IsA("VehicleSeat") or child:IsA("Seat") then
				seat = child
				break
			end
		end
	end

	if not seat then return false end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return false end

	rootPart.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
	rootPart.Velocity = Vector3.zero
	rootPart.RotVelocity = Vector3.zero
	task.wait(0.1)

	for i = 1, 5 do
		pcall(function() seat:Sit(humanoid) end)
		task.wait(0.1)
		if humanoid.SeatPart == seat then return true end
		rootPart.CFrame = seat.CFrame + Vector3.new(0, 1.5 + (i * 0.2), 0)
		task.wait(0.1)
	end

	return humanoid.SeatPart == seat
end

local function GetSeatedBlobman()
	local char = LocalPlayer.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local seat = humanoid.SeatPart
	if not seat or not seat:IsA("VehicleSeat") then return nil end
	local obj = seat
	while obj do
		if obj:IsA("Model") and obj.Name == "CreatureBlobman" then return obj end
		obj = obj.Parent
	end
	return nil
end

local function SpawnBlobmanForKill()
	local seated = GetSeatedBlobman()
	if seated then 
		currentBlobman = seated 
		return seated 
	end

	if currentBlobman and currentBlobman.Parent then
		local blobPos = nil
		if currentBlobman.PrimaryPart then
			blobPos = currentBlobman.PrimaryPart.Position
		else
			local part = currentBlobman:FindFirstChildWhichIsA("BasePart")
			if part then blobPos = part.Position end
		end
		local char = LocalPlayer.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		local localPos = rootPart and rootPart.Position
		if blobPos and localPos and (blobPos - localPos).Magnitude < 500 then
			if MountBlobman(currentBlobman) then return currentBlobman end
		else
			pcall(function() currentBlobman:Destroy() end)
			currentBlobman = nil
		end
	end

	local char = LocalPlayer.Character
	if not char then return nil end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end

	local spawnRemote = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
	if not spawnRemote then return nil end

	local blobman = nil
	for attempt = 1, 5 do
		local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -5)
		pcall(function() 
			spawnRemote:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0)) 
		end)
		task.wait(0.3)
		
		local toyFolderName = LocalPlayer.Name .. "SpawnedInToys"
		local toyFolder = Workspace:FindFirstChild(toyFolderName)
		if toyFolder then
			blobman = toyFolder:FindFirstChild("CreatureBlobman")
			if blobman then 
				currentBlobman = blobman
				break 
			end
		end
		task.wait(0.2)
	end

	if not blobman then return nil end
	currentBlobman = blobman

	if MountBlobman(blobman) then return blobman end

	for retry = 1, 3 do
		pcall(function() 
			local destroyToy = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
			if destroyToy and blobman then
				destroyToy:FireServer(blobman)
			end
		end)
		task.wait(0.3)
		
		local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -5)
		pcall(function() 
			spawnRemote:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0)) 
		end)
		task.wait(0.3)
		
		local toyFolderName = LocalPlayer.Name .. "SpawnedInToys"
		local toyFolder = Workspace:FindFirstChild(toyFolderName)
		if toyFolder then
			blobman = toyFolder:FindFirstChild("CreatureBlobman")
			if blobman then
				currentBlobman = blobman
				if MountBlobman(blobman) then return blobman end
			end
		end
	end

	return nil
end

local function KillPlayer(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return false end
	local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end

	for _ = 1, maxRetries do
		local success = pcall(function()
			humanoid.BreakJointsOnDeath = false
			humanoid:ChangeState(Enum.HumanoidStateType.Dead)
		end)
		if success and humanoid.Health <= 0 then return true end
		task.wait(0.005)
	end
	return false
end

local function GrabRelease(blobman, targetRoot)
	if not blobman or not targetRoot then return end
	pcall(function()
		local script = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
		if script then
			local leftDet = blobman:FindFirstChild("LeftDetector")
			local leftWeld = leftDet and leftDet:FindFirstChild("LeftWeld")
			if script:FindFirstChild("CreatureGrab") and leftDet and leftWeld then
				script.CreatureGrab:FireServer(leftDet, targetRoot, leftWeld)
			end
			if script:FindFirstChild("CreatureRelease") and leftDet and leftWeld then
				script.CreatureRelease:FireServer(leftWeld)
			end
		end
	end)
end

local function ProcessAllPlayers()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = char.HumanoidRootPart

	local blobman = nil
	for retry = 1, 10 do
		blobman = SpawnBlobmanForKill()
		if blobman then break end
		task.wait(0.5)
	end
	
	if not blobman then 
		pcall(function()
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid.Health = 0 end
		end)
		task.wait(0.5)
		return 
	end

	local targets = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(targets, player)
		end
	end

	for _, player in ipairs(targets) do
		if not isRunning then break end

		local targetChar = player.Character
		if not targetChar then continue end

		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
		if not targetRoot then continue end

		rootPart.CFrame = targetRoot.CFrame
		task.wait(TP_WAIT)

		KillPlayer(player)

		for _ = 1, 2 do
			GrabRelease(blobman, targetRoot)
			task.wait(GRAB_WAIT)
		end
	end
end

local function StartKillAll()
	if isRunning then return end
	isRunning = true

	if killTask then
		task.cancel(killTask)
		killTask = nil
	end

	killTask = task.spawn(function()
		while isRunning do
			pcall(ProcessAllPlayers)
			task.wait()
		end
	end)
end

local function StopKillAll()
	isRunning = false
	if killTask then
		task.cancel(killTask)
		killTask = nil
	end
end

-- =====================================================
-- ★★★ 防御機能 (アンチキック + アンチグラブ + アンチラグ) ★★★
-- =====================================================

-- ===== アンチキック機能 =====
shurikenAntiKickActive = false

local function ClearKunai()
    local inv = Workspace:FindFirstChild(LocalPlayer.Name.."SpawnedInToys")
    local destroyrem = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
    if inv and destroyrem then
        for _, v in pairs(inv:GetChildren()) do
            if v.Name == "AntiKick" or v.Name == "NinjaShuriken" then
                pcall(function() destroyrem:FireServer(v) end)
            end
        end
    end
end

local function StartAntiKick()
    shurikenAntiKickActive = true
    task.spawn(function()
        local setOwner = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
        local stickyEvent = ReplicatedStorage:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
        local spawnRemote = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        local canSpawn = LocalPlayer:WaitForChild("CanSpawnToy")
        
        local function getHRP()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                return LocalPlayer.Character.HumanoidRootPart
            else
                local character = LocalPlayer.CharacterAdded:Wait()
                return character:WaitForChild("HumanoidRootPart")
            end
        end
        
        local function StickKunai(kunai)
            if not kunai or not kunai:FindFirstChild("StickyPart") then return end
            local currentHRP = getHRP()
            if not currentHRP then return end
            local firePart = currentHRP:FindFirstChild("FirePlayerPart") or currentHRP:WaitForChild("FirePlayerPart", 5)
            if not firePart then return end
            
            for _, obj in pairs(kunai:GetChildren()) do
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                    obj.CanCollide = false
                    obj.CanQuery = false
                    obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    if obj.Name == "Pyramid" then
                        obj.Transparency = 0
                    elseif obj.Name == "Main" then
                        obj.Transparency = 0
                    else
                        obj.Transparency = 1
                    end
                end
            end
            
            if kunai:FindFirstChild("SoundPart") then
                if not kunai.SoundPart:FindFirstChild("PartOwner") or kunai.SoundPart.PartOwner.Value ~= LocalPlayer.Name then
                    pcall(function() setOwner:FireServer(kunai.SoundPart, kunai.SoundPart.CFrame) end)
                end
            end
            
            local targetCFrame = firePart.CFrame * CFrame.Angles(0, math.rad(90), math.rad(90))
            kunai:PivotTo(targetCFrame)
            stickyEvent:FireServer(kunai.StickyPart, firePart, CFrame.new(0,0,0) * CFrame.Angles(0,math.rad(90),math.rad(90)))
        end
        
        while shurikenAntiKickActive do
            task.wait(0.05)
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or LocalPlayer.Character.Humanoid.Health <= 0 then continue end
            
            local inv = Workspace:FindFirstChild(LocalPlayer.Name.."SpawnedInToys")
            local kunai = inv and inv:FindFirstChild("NinjaShuriken") or (inv and inv:FindFirstChild("AntiKick"))
            
            if not kunai then
                local currentHRP = getHRP()
                if currentHRP then
                    pcall(function()
                        spawnRemote:InvokeServer("NinjaShuriken", currentHRP.CFrame * CFrame.new(0, 2, 2), Vector3.new(0,0,0))
                    end)
                end
                task.wait(0.3)
                inv = Workspace:FindFirstChild(LocalPlayer.Name.."SpawnedInToys")
                kunai = inv and inv:FindFirstChild("NinjaShuriken")
                if kunai then
                    kunai.Name = "AntiKick"
                    StickKunai(kunai)
                end
            end
            
            if kunai and kunai:FindFirstChild("StickyPart") then
                local isWelded = kunai.StickyPart:FindFirstChild("StickyWeld") and kunai.StickyPart.StickyWeld.Part1 ~= nil
                if not isWelded and kunai.StickyPart.CanTouch == true then
                    StickKunai(kunai)
                    kunai.Name = "AntiKick"
                    task.wait(0.1)
                end
            end
        end
        ClearKunai()
    end)
end

local function StopAntiKick()
    shurikenAntiKickActive = false
    ClearKunai()
end

-- ===== アンチグラブ機能 =====
AntiGrabEnabled = false
struggleEvent = nil
isHeldValue = nil

task.spawn(function()
    local characterEventsFolder = ReplicatedStorage:FindFirstChild("CharacterEvents", 10)
    if characterEventsFolder then
        struggleEvent = characterEventsFolder:WaitForChild("Struggle", 5)
    end
    isHeldValue = LocalPlayer:FindFirstChild("IsHeld", 10)
end)

local function AntiGrabHandler()
    if not AntiGrabEnabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    if isHeldValue and isHeldValue.Value == true then
        pcall(function() if struggleEvent then struggleEvent:FireServer(LocalPlayer) end end)
        humanoidRootPart.Velocity = Vector3.zero
        humanoidRootPart.Anchored = true
    else
        humanoidRootPart.Anchored = false
    end
end

RunService.Heartbeat:Connect(AntiGrabHandler)

local function StartAntiGrab()
    AntiGrabEnabled = true
end

local function StopAntiGrab()
    AntiGrabEnabled = false
    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then humanoidRootPart.Anchored = false end
    end
end

-- ===== アンチラグ機能 =====
antiLagEnabled = false
lines = 0
lagger = nil

workspace.DescendantAdded:Connect(function(d)
    if d.Name == "GrabBeam" then
        lines = lines + 1
        lagger = d.Parent and d.Parent.Parent and d.Parent.Parent.Parent
    end
end)

local function StartAntiLag()
    antiLagEnabled = true
    lines = 0
    pcall(function()
        LocalPlayer.PlayerScripts.CharacterAndBeamMove.Enabled = false
    end)
    
    task.spawn(function()
        while antiLagEnabled do
            if lines > 100 then
                pcall(function()
                    LocalPlayer.PlayerScripts.CharacterAndBeamMove.Enabled = false
                end)
                lines = 0
            end
            task.wait(0.5)
        end
    end)
end

local function StopAntiLag()
    antiLagEnabled = false
    pcall(function()
        LocalPlayer.PlayerScripts.CharacterAndBeamMove.Enabled = true
    end)
end

-- =====================================================
-- ★★★ ブロブキック機能 (キックタブ用) ★★★
-- =====================================================
local selectedKickPlayer = nil
local kickLoopEnabled = false

local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.DisplayName .. " (" .. plr.Name .. ")")
        end
    end
    return list
end

local function getPlayerFromSelection(selection)
    if not selection then return nil end
    local username = selection:match("%((.-)%)")
    if username then
        return Players:FindFirstChild(username)
    end
    return nil
end

-- =====================================================
-- ★★★ Blobman Kick All 機能 (キックタブ用) ★★★
-- =====================================================
local KICKALL_MAX_RETRIES = 5
local KICKALL_TP_WAIT = 0.02
local KICKALL_GRAB_WAIT = 0.01
local friendWhitelist = false
local isKickAllRunning = false

local function isTargetable(player)
    if not player or player == LocalPlayer then return false end
    if friendWhitelist then
        local isFriend = false
        pcall(function()
            isFriend = LocalPlayer:IsFriendsWith(player.UserId)
        end)
        if isFriend then return false end
    end
    return true
end

local function GetAllPlayers()
    local players = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if isTargetable(player) then
            table.insert(players, player)
        end
    end
    return players
end

local function SpawnBlobmanForKickAll()
    local char = LocalPlayer.Character
    if not char then return nil end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -5)
    
    local success, err = pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            "CreatureBlobman",
            spawnPos,
            Vector3.new(0, 127, 0)
        )
    end)
    
    if not success then return nil end
    
    local toyFolderName = LocalPlayer.Name .. "SpawnedInToys"
    local blobman = nil
    local startTime = tick()
    repeat
        local toyFolder = Workspace:FindFirstChild(toyFolderName)
        if toyFolder then
            blobman = toyFolder:FindFirstChild("CreatureBlobman")
        end
        if blobman then break end
        task.wait()
    until tick() - startTime > 2
    
    return blobman
end

local function SitOnBlobman(blobman)
    if not blobman then return false end
    local seat = blobman:FindFirstChild("VehicleSeat")
    if not seat then return false end
    
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if rootPart then
        rootPart.CFrame = seat.CFrame
    end
    
    seat:Sit(humanoid)
    task.wait(0.3)
    return true
end

local function KillPlayerKickAll(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    for _ = 1, KICKALL_MAX_RETRIES do
        pcall(function()
            humanoid.BreakJointsOnDeath = false
            humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        end)
        if humanoid.Health <= 0 then return true end
        task.wait(0.01)
    end
    return false
end

local function GrabReleaseKickAll(blobman, targetRoot)
    if not blobman or not targetRoot then return end
    pcall(function()
        local script = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
        if script then
            script.CreatureGrab:FireServer(
                blobman.LeftDetector,
                targetRoot,
                blobman.LeftDetector.LeftWeld
            )
            script.CreatureRelease:FireServer(
                blobman.LeftDetector.LeftWeld
            )
        end
    end)
end

local function ExecuteBlobmanKickAll()
    if isKickAllRunning then return end
    isKickAllRunning = true
    
    local allPlayers = GetAllPlayers()
    
    if #allPlayers == 0 then
        Library:Notify("⚠️ ターゲットが見つかりません", 3)
        isKickAllRunning = false
        return
    end
    
    Library:Notify("🎯 ターゲット " .. #allPlayers .. " 人を検出", 2)
    
    local blobman = SpawnBlobmanForKickAll()
    if not blobman then
        Library:Notify("❌ Blobmanのスポーンに失敗しました", 3)
        isKickAllRunning = false
        return
    end
    
    if not SitOnBlobman(blobman) then
        Library:Notify("❌ Blobmanに座れませんでした", 3)
        isKickAllRunning = false
        return
    end
    
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        Library:Notify("❌ キャラクターが見つかりません", 3)
        isKickAllRunning = false
        return
    end
    
    Library:Notify("🚀 キック処理を開始...", 2)
    
    for _, targetPlayer in ipairs(allPlayers) do
        if not isKickAllRunning then break end
        
        local targetChar = targetPlayer.Character
        if not targetChar then 
            continue 
        end
        
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then 
            continue 
        end
        
        rootPart.CFrame = targetRoot.CFrame
        task.wait(KICKALL_TP_WAIT)
        
        KillPlayerKickAll(targetPlayer)
        
        for i = 1, 3 do
            GrabReleaseKickAll(blobman, targetRoot)
            task.wait(KICKALL_GRAB_WAIT)
        end
    end
    
    rootPart.CFrame = CFrame.new(0, 100, 0)
    task.wait(0.1)
    
    local radius = 15
    for i, targetPlayer in ipairs(allPlayers) do
        local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local angle = math.rad((i - 1) * (360 / #allPlayers))
            local x = radius * math.cos(angle)
            local z = radius * math.sin(angle)
            targetRoot.CFrame = CFrame.new(x, 110, z)
        end
    end
    
    task.wait(0.1)
    
    for _ = 1, 2 do
        for _, targetPlayer in ipairs(allPlayers) do
            local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(targetRoot, CFrame.new(targetRoot.Position))
                    ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(targetRoot)
                end)
            end
        end
        task.wait(0.1)
    end
    
    task.wait(0.3)
    for _, targetPlayer in ipairs(allPlayers) do
        local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            pcall(function()
                blobman.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(
                    blobman.LeftDetector, targetRoot, blobman.LeftDetector.LeftWeld
                )
                blobman.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(
                    blobman.RightDetector, targetRoot, blobman.RightDetector.RightWeld
                )
            end)
        end
    end
    
    task.wait(0.1)
    
    for _, part in ipairs(blobman:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part.Anchored = false end)
        end
    end
    
    Library:Notify("✅ Blobman Kick All 完了！", 3)
    isKickAllRunning = false
end

-- =====================================================
-- ★★★ プレイヤー機能 (三人称視点 + 無限ジャンプ) ★★★
-- =====================================================
local infJumpEnabled = false

-- 三人称視点 (プレイヤータブ用)
local function enableThirdPersonPlayer()
    pcall(function()
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
        LocalPlayer.CameraMaxZoomDistance = 1000
        LocalPlayer.CameraMinZoomDistance = 0.5
    end)
end

local function disableThirdPersonPlayer()
    pcall(function()
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
        LocalPlayer.CameraMaxZoomDistance = 0
        LocalPlayer.CameraMinZoomDistance = 0
    end)
end

-- 無限ジャンプ
UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

