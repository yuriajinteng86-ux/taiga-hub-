-- ===== 左グループ: ブロブキック (単体) =====
local KickLeftGroup = Tabs.Kick:AddLeftGroupbox("ブロブキック (単体)", "user")

KickLeftGroup:AddDropdown("KickTargetPlayer", {
    Values = getPlayerList(),
    Default = "",
    Text = "ターゲットプレイヤー",
    Tooltip = "キックするプレイヤーを選択",
    Searchable = true,
    Callback = function(Value)
        selectedKickPlayer = getPlayerFromSelection(Value)
    end,
})

KickLeftGroup:AddButton({
    Text = "🔄 プレイヤーリスト更新",
    Func = function()
        local newList = getPlayerList()
        Options.KickTargetPlayer:SetValues(newList)
        Library:Notify({
            Title = "更新完了",
            Description = "プレイヤーリストを更新しました",
            Time = 2,
        })
    end,
    Tooltip = "プレイヤー一覧を最新に更新",
})

KickLeftGroup:AddDivider()

KickLeftGroup:AddToggle("BlobKick", {
    Text = "ブロブキック",
    Tooltip = "ブロブマンに乗った状態でターゲットを拘束・キック",
    DisabledTooltip = "ターゲットを選択してください",
    Default = false,
    Risky = true,
    Callback = function(Value)
        if Value and not selectedKickPlayer then
            Library:Notify({
                Title = "エラー",
                Description = "先にターゲットプレイヤーを選択してください",
                Time = 3,
            })
            Toggles.BlobKick:SetValue(false)
            return
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local seat = hum and hum.SeatPart

        if Value and (not seat or not seat.Parent or seat.Parent.Name ~= "CreatureBlobman") then
            Library:Notify({
                Title = "エラー",
                Description = "ブロブマンに乗っている必要があります",
                Time = 3,
            })
            Toggles.BlobKick:SetValue(false)
            return
        end

        kickLoopEnabled = Value

        if not Value then
            Library:Notify({
                Title = "停止",
                Description = "ブロブキックを停止しました",
                Time = 2,
            })
            return
        end

        local target = selectedKickPlayer

        Library:Notify({
            Title = "開始",
            Description = target.DisplayName .. " をキックします",
            Time = 3,
        })

        task.spawn(function()
            local GE = ReplicatedStorage:WaitForChild("GrabEvents")
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local seat = hum and hum.SeatPart
            local blob = seat.Parent
            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
            local R_Det = blob:FindFirstChild("RightDetector")
            local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))
            local SavedPos = blobRoot.CFrame

            local tChar = target.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if tRoot and blobRoot then
                local bringStart = tick()
                while tick() - bringStart < 0.35 do
                    if not kickLoopEnabled then break end
                    pcall(function()
                        blobRoot.CFrame = tRoot.CFrame
                        blobRoot.Velocity = Vector3.zero
                        if CG and R_Det then
                            CG:FireServer(R_Det, tRoot, R_Weld)
                        end
                        GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                    end)
                    RunService.Heartbeat:Wait()
                end
                pcall(function()
                    blobRoot.CFrame = SavedPos
                    blobRoot.Velocity = Vector3.zero
                end)
                task.wait(0.05)
            end

            local packetTimer = 0
            while kickLoopEnabled do
                if not target or not target.Parent or not target.Character then
                    break
                end

                tChar = target.Character
                tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")

                if tRoot and tHum and tHum.Health > 0 then
                    pcall(function()
                        blobRoot.CFrame = SavedPos
                        blobRoot.Velocity = Vector3.zero

                        local lockPos = SavedPos * CFrame.new(0, 23, 0)
                        tRoot.CFrame = lockPos
                        tRoot.Velocity = Vector3.zero
                        tRoot.RotVelocity = Vector3.zero

                        if tick() - packetTimer > 0.05 then
                            packetTimer = tick()
                            tHum.PlatformStand = true
                            tHum.Sit = true
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            if R_Det then
                                local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                if weld then
                                    CD:FireServer(weld)
                                end
                            end
                            GE.DestroyGrabLine:FireServer(tRoot)
                            if CG and R_Det then
                                CG:FireServer(R_Det, tRoot, R_Weld)
                            end
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        end
                    end)
                else
                    pcall(function()
                        if blobRoot and blobRoot.Parent then
                            blobRoot.CFrame = SavedPos
                            blobRoot.Velocity = Vector3.zero
                        end
                    end)
                end

                RunService.Heartbeat:Wait()
            end

            kickLoopEnabled = false
            pcall(function()
                if blobRoot and blobRoot.Parent then
                    blobRoot.CFrame = SavedPos
                    blobRoot.Velocity = Vector3.zero
                end
            end)

            Toggles.BlobKick:SetValue(false)
            Library:Notify({
                Title = "停止",
                Description = "ブロブキックを終了しました",
                Time = 2,
            })
        end)
    end,
})

