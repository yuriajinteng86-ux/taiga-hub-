-- 無限ジャンプキーバインド
PlayerGroup:AddLabel("無限ジャンプ キーバインド")
    :AddKeyPicker("InfJumpKeybind", {
        Default = "J",
        NoUI = false,
        Text = "無限ジャンプ切替",
        Mode = "Toggle",
        Callback = function(Value)
            if Toggles.InfJumpToggle then
                Toggles.InfJumpToggle:SetValue(Value)
            end
        end,
    })

-- 右グループ: 情報
local PlayerInfoGroup = Tabs.Player:AddRightGroupbox("情報", "info")

PlayerInfoGroup:AddLabel("🔹 プレイヤー機能")
PlayerInfoGroup:AddLabel("")
PlayerInfoGroup:AddLabel("⚙️ 機能一覧:")
PlayerInfoGroup:AddLabel("• 三人称視点 (Vキー)")
PlayerInfoGroup:AddLabel("• 無限ジャンプ (Jキー)")
PlayerInfoGroup:AddLabel("")
PlayerInfoGroup:AddLabel("💡 ヒント:")
PlayerInfoGroup:AddLabel("キーバインドは変更可能です")

-- =====================================================
-- ★★★ UI Settings タブ ★★★
-- =====================================================
local MenuGroup = Tabs["UI Settings"]:AddLeftGroupbox("Menu", "wrench")

MenuGroup:AddToggle("KeybindMenuOpen", {
	Default = Library.KeybindFrame.Visible,
	Text = "Open Keybind Menu",
	Callback = function(value)
		Library.KeybindFrame.Visible = value
	end,
})

MenuGroup:AddToggle("ShowCustomCursor", {
	Text = "Custom Cursor",
	Default = true,
	Callback = function(Value)
		Library.ShowCustomCursor = Value
	end,
})

MenuGroup:AddDropdown("NotificationSide", {
	Values = { "Left", "Right" },
	Default = "Right",
	Text = "Notification Side",
	Callback = function(Value)
		Library:SetNotifySide(Value)
	end,
})

MenuGroup:AddDropdown("DPIDropdown", {
	Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
	Default = "100%",
	Text = "DPI Scale",
	Callback = function(Value)
		Value = Value:gsub("%%", "")
		Library:SetDPIScale(tonumber(Value))
	end,
})

MenuGroup:AddDivider()
MenuGroup:AddLabel("Menu bind")
	:AddKeyPicker("MenuKeybind", { Default = "RightShift", NoUI = true, Text = "Menu keybind" })

MenuGroup:AddButton("Unload", function()
	StopKillAll()
	DisableThirdPersonKill()
	StopAntiKick()
	StopAntiGrab()
	StopAntiLag()
	if kickLoopEnabled then
		kickLoopEnabled = false
		Toggles.BlobKick:SetValue(false)
	end
	isKickAllRunning = false
	disableThirdPersonPlayer()
	infJumpEnabled = false
	if Toggles.InfJumpToggle then
		Toggles.InfJumpToggle:SetValue(false)
	end
	if Toggles.ThirdPersonPlayerToggle then
		Toggles.ThirdPersonPlayerToggle:SetValue(false)
	end
	Library:Unload()
end)

Library.ToggleKeybind = Options.MenuKeybind

-- =====================================================
-- マネージャーの設定
-- =====================================================
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ 
	"MenuKeybind",
	"ThirdPersonKeybind",
	"InfJumpKeybind"
})

ThemeManager:SetFolder("TaigaHubFTAP")
SaveManager:SetFolder("TaigaHubFTAP")

SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:ApplyToTab(Tabs["UI Settings"])

SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
	StopKillAll()
	DisableThirdPersonKill()
	StopAntiKick()
	StopAntiGrab()
	StopAntiLag()
	if kickLoopEnabled then
		kickLoopEnabled = false
		Toggles.BlobKick:SetValue(false)
	end
	isKickAllRunning = false
	disableThirdPersonPlayer()
	infJumpEnabled = false
	if Toggles.InfJumpToggle then
		Toggles.InfJumpToggle:SetValue(false)
	end
	if Toggles.ThirdPersonPlayerToggle then
		Toggles.ThirdPersonPlayerToggle:SetValue(false)
	end
	print("Taiga hub v0.1 unloaded!")
end)