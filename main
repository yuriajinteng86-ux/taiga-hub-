KillGroupBox:AddButton({
	Text = "Manual Kill (Target)",
	Func = function()
		local target = Options.KillTargetDropdown and Options.KillTargetDropdown.Value
		if target and target ~= "None" then
			local player = Players:FindFirstChild(target)
			if player then
				KillPlayer(player)
				Library:Notify({
					Title = "Kill",
					Description = "Killed: " .. target,
					Time = 2,
				})
			end
		end
	end,
	Tooltip = "選択したターゲットをキルします",
})

local function UpdatePlayerList()
	local playerNames = { "None" }
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(playerNames, player.Name)
		end
	end
	return playerNames
end

KillGroupBox:AddDropdown("KillTargetDropdown", {
	Values = UpdatePlayerList(),
	Default = 1,
	Text = "Kill Target",
	Tooltip = "キルするプレイヤーを選択",
	Callback = function(Value)
		print("Selected target:", Value)
	end,
})

KillGroupBox:AddButton({
	Text = "Refresh Player List",
	Func = function()
		local newValues = UpdatePlayerList()
		Options.KillTargetDropdown:SetValues(newValues)
		Library:Notify({
			Title = "Player List",
			Description = "Updated!",
			Time = 1.5,
		})
	end,
	Tooltip = "プレイヤーリストを更新します",
})

